  targetText: "\u0426\u0435\u043B\u044C \u0438\u0433\u0440\u044B - \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u044C
    \u043F\u043E\u043B\u0435 \u0431\u0443\u043A\u0432\u0430\u043C\u0438"
  selectCell1Text: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u043A\u043B\u0435\u0442\u043A\u0443"
  typeLetter1Text: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0431\u0443\u043A\u0432\u0443:
    <color=orange>{0}</color> "
  writeWordText: "\u0421\u043E\u0431\u0435\u0440\u0438\u0442\u0435 \u0441\u043B\u043E\u0432\u043E:
    <color=orange>{0}</color>"
  selectCell2Text: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u043A\u043B\u0435\u0442\u043A\u0443"
  typeLetter2Text: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0431\u0443\u043A\u0432\u0443:
    <color=orange>{0}</color>"
  startWord1Text: "\u0421\u043E\u0431\u0435\u0440\u0438\u0442\u0435 \u0441\u043B\u043E\u0432\u043E
    \u043F\u043E \u043E\u0434\u043D\u043E\u0439 \u0431\u0443\u043A\u0432\u0435"
  addLetter1Text: "\u0414\u043E\u0431\u0430\u0432\u044C\u0442\u0435 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0443\u044E
    \u0431\u0443\u043A\u0432\u0443"
  cancelText: "\u041A\u0430\u0436\u0435\u0442\u0441\u044F, \u0442\u0443\u0442 \u0435\u0441\u0442\u044C
    \u0441\u043B\u043E\u0432\u043E \u043F\u043E\u0431\u043E\u043B\u044C\u0448\u0435...
    \u0414\u0430\u0432\u0430\u0439\u0442\u0435 <color=red>\u043E\u0442\u043C\u0435\u043D\u0438\u043C</color>..."
  startWord2Text: "\u041D\u0430\u0447\u043D\u0438\u0442\u0435 \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C
    \u0441\u043B\u043E\u0432\u043E"
  addLetter2Text: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0443\u044E
    \u043A\u043B\u0435\u0442\u043A\u0443"
  okText: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435  <color=#036900>\u041E\u041A</color>"
